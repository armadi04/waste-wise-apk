{
  "name": "waste-wise-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@parcel/watcher"
  ],
  "main": "expo-router/entry",
  "scripts": {
    "start": "bun --bun expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint .",
    "test": "bun test",
    "api:generate": "bunx --bun -p typescript@5.9.3 -p openapi-typescript@7.13.0 openapi-typescript ../waste-wise-web/backend/swagger.json -o src/types/api.generated.ts",
    "export:android": "bun --bun expo export --platform android",
    "doctor": "bunx --bun expo-doctor",
    "build:apk": "bunx --bun -p eas-cli eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@hookform/resolvers": "^7.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@tanstack/react-query": "^5.105.3",
    "axios": "^1.21.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lottie-react-native": "^7.5.0",
    "lucide-react-native": "^1.67.0",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
