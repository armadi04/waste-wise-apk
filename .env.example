# Backend API base, including /api/v1.
# Android emulator host machine: http://10.0.2.2:3000/api/v1
# USB device/emulator with `adb reverse tcp:3000 tcp:3000`: http://localhost:3000/api/v1
# Physical device over Wi-Fi: http://<LAN-IP>:3000/api/v1
# Production: https://your-api-domain.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Google OAuth web/server client ID. Must match backend GOOGLE_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
